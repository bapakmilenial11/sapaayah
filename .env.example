# ==============================================================================
# SAPA Ayah Digital Platform - Environment Configuration Template
# Salin file ini menjadi .env.local untuk konfigurasi lingkungan lokal
# ==============================================================================

# Public Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Keys (Aman untuk Client Browser & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (DILARANG KERAS diekspos ke client bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

